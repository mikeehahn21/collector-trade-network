# approve build scripts for pnpm 10+
only-built-dependencies[]=@sentry/cli
only-built-dependencies[]=sharp

# hoist Expo autolinking packages so Android Gradle can find them
public-hoist-pattern[]=*expo-modules-core
public-hoist-pattern[]=*babel-preset-expo
# hoist nanoid so Metro can resolve it from expo-router
public-hoist-pattern[]=nanoid
