    "@ctn/utils": "workspace:*",
    "@ctn/validation": "workspace:*",
    "expo": "^57.0.15",
    "expo-asset": "~57.0.13",
    "expo-auth-session": "~57.0.8",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "^57.0.14",
    "expo-font": "~57.0.1",
