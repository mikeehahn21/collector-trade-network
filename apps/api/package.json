{
  "name": "@ctn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/add-js-extensions.mjs",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node-pg-migrate -m migrations up",
    "db:rollback": "node-pg-migrate -m migrations down"
  },
  "dependencies": {
    "@clerk/backend": "^1.20.0",
    "@ctn/api-contracts": "workspace:*",
    "@ctn/constants": "workspace:*",
    "@ctn/types": "workspace:*",
    "@ctn/validation": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "bullmq": "^5.21.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^7.7.1",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
