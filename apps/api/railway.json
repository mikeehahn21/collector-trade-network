{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @ctn/api build",
    "watchPatterns": ["src/**"]
  },
  "deploy": {
    "startCommand": "node dist/src/server.js",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
